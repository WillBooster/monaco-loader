{
  "name": "@willbooster/monaco-loader",
  "version": "0.0.0-semantically-released",
  "description": "the library aims to setup monaco editor into your browser",
  "keywords": [
    "editor",
    "loader",
    "monaco",
    "monaco editor",
    "monaco-editor"
  ],
  "homepage": "https://github.com/WillBooster/monaco-loader",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WillBooster/monaco-loader.git"
  },
  "license": "MIT",
  "author": "WillBooster Inc.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "build-ts lib",
    "cleanup": "bun wb lint --fix --format",
    "format": "bun wb lint --format",
    "lint": "bun wb lint",
    "lint-fix": "bun wb lint --fix",
    "prepare": "(bun lefthook install || true) && (test ! -f .lefthook/normalize-bun-lockfile.sh || bash .lefthook/normalize-bun-lockfile.sh)",
    "test": "bun wb test",
    "test/ci": "bun wb test-on-ci",
    "test/ci-setup": "playwright install chromium",
    "typecheck": "bun wb typecheck",
    "verify": "bun wb verify",
    "verify-full": "bun wb verify --full"
  },
  "dependencies": {
    "monaco-editor": "0.56.0"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@tsconfig/bun": "1.0.10",
    "@tsconfig/node-lts": "24.0.0",
    "@tsconfig/node-ts": "23.6.4",
    "@tsconfig/node24": "24.0.4",
    "@types/bun": "1.3.14",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@willbooster/oxfmt-config": "1.2.2",
    "@willbooster/oxlint-config": "1.4.8",
    "@willbooster/wb": "22.0.1",
    "build-ts": "21.0.9",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "jsdom": "29.0.2",
    "lefthook": "2.1.10",
    "next": "16.3.0-preview.6",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "semantic-release": "25.0.3",
    "sort-package-json": "4.0.0",
    "typescript": "7.0.2",
    "vitest": "4.1.4"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
